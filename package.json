{
  "name": "sideflow",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.overlay.config.js && node scripts/build-extension.js",
    "test": "node --test tests/model.test.js",
    "check": "npm run build && npm test",
    "test:ui": "playwright test",
    "package": "npm run build && python3 scripts/package-extension.py"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
